#!/usr/bin/env bash
case "$*" in
    *repo*view*nameWithOwner*)  echo 'owner/repo' ;;
    *graphql*)                   echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]}}}}}' ;;
    *api*pulls*reviews*)         echo '[]' ;;
    # Real gh rejects --comments with --json ("specify only one of --comments or
    # --json", #881); mirror that so a caller passing both fails here too.
    *pr*view*--comments*--json*|*pr*view*--json*--comments*)
        echo 'specify only one of --comments or --json' >&2; exit 1 ;;
    *pr*view*--json\ comments*) echo '{"comments":[]}' ;;
    *api*check-runs*)            echo '{"check_runs":[]}' ;;
    *api*statuses*)              echo '[]' ;;
    *api*issues*reactions*)      echo '[]' ;;
    *api*commits*--jq*)
        # GH_MOCK_FAIL_COMMITTER_DATE=1 fails ONLY this committer-date call, to
        # exercise the #189 partial-failure contract (committer fetch fails but
        # FETCH_OK must stay 1 because the value is no longer consumed).
        if [ "${GH_MOCK_FAIL_COMMITTER_DATE:-0}" = "1" ]; then exit 1; fi
        echo '2024-01-01T00:00:00Z' ;;
    *api*events*)
        if [ -n "${GH_MOCK_EVENTS_FILE:-}" ] && [ -f "${GH_MOCK_EVENTS_FILE}" ]; then
            cat "${GH_MOCK_EVENTS_FILE}"
        else
            echo '[]'
        fi ;;
    # github-server-now.sh reads GitHub's clock from this response's Date header
    # (THREADS_FETCHED_AT, ADR 0058).
    *api*-i*rate_limit*)         printf 'HTTP/2.0 200 OK\nDate: Mon, 19 Oct 2026 00:01:10 GMT\n\n{}\n' ;;
    *pr*view*headRefOid*)        echo '{"headRefOid":"abcdef1234567890abcdef1234567890abcdef12","headRefName":"feat/test-branch"}' ;;
    *)                           echo '{}' ;;
esac
